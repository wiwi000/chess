{
  "manifest_version": 3,
  "name": "XiangqiBot — Highlight Best Move",
  "version": "6.1.5",
  "description": "Phân tích & highlight nước đi tốt nhất bằng Pikafish WebAssembly chạy trực tiếp trong extension.",
  "permissions": [
    "scripting",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://play.xiangqi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://play.xiangqi.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "engine_worker.js",
        "pikafish.js",
        "pikafish.wasm",
        "pikafish.data"
      ],
      "matches": [
        "https://play.xiangqi.com/*",
        "http://play.xiangqi.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "XiangqiBot — Highlight"
  }
}
